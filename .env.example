# Database (PostgreSQL)
DATABASE_URL="postgresql://eventa:eventa@localhost:5432/eventa"

# Session signing secret: use a long random string in production
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL (used for payment callbacks and QR links)
APP_URL="http://localhost:3000"

# AI planner (Anthropic Claude). Required for AI plans and the assistant chat.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Payments: "mock" for local testing, "paystack" for real sandbox/live payments
PAYMENT_PROVIDER="mock"
PAYSTACK_SECRET_KEY=""

# Platform economics
PLATFORM_COMMISSION_PCT="10"
PRO_COMMISSION_PCT="8"
CLIENT_PROTECTION_FEE_PCT="2"
AUTO_RELEASE_HOURS="72"

# Show contract-signing OTP codes on screen instead of sending SMS (testing only; never in production)
SHOW_DEV_OTP="1"
# SMS provider for OTPs in production (e.g. Termii). Not wired yet.
TERMII_API_KEY=""

# Protects the auto-release cron endpoint (/api/cron/auto-release)
CRON_SECRET="change-me"
